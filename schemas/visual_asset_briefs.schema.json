{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_asset_briefs.schema.json",
  "title": "Cria do Tatame Visual Asset Briefs",
  "type": "object",
  "required": ["$schema", "version", "status", "shipping_ready", "briefs"],
  "properties": {
    "$schema": {"const": "visual_asset_briefs_v1"},
    "version": {"type": "string"},
    "status": {"const": "specified_candidates_only"},
    "shipping_ready": {"const": false},
    "briefs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "asset_type", "generation_role", "screen_contract", "reference_ids", "resolution", "palette_tokens", "subject", "safe_zones", "forbidden", "required_review"],
        "properties": {
          "id": {"type": "string"},
          "asset_type": {"enum": ["environment", "character", "paired_animation", "prop", "ui_source"]},
          "generation_role": {"type": "string"},
          "screen_contract": {"type": "string"},
          "reference_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "resolution": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 64}},
          "palette_tokens": {"type": "array", "minItems": 3, "items": {"type": "string"}},
          "subject": {"type": "string", "minLength": 20},
          "safe_zones": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "forbidden": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "required_review": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
