{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_asset_bom.schema.json",
  "title": "Cria do Tatame Visual Asset Bill of Materials",
  "type": "object",
  "required": ["$schema", "version", "status", "source_authority", "counting_unit", "file_count_claimed", "batch_policy", "targets", "gold_slice_priority", "promotion_states"],
  "properties": {
    "$schema": {"const": "visual_asset_bom_v1"},
    "version": {"type": "string"},
    "status": {"const": "production_plan"},
    "source_authority": {"type": "string"},
    "counting_unit": {"const": "approved_asset_pack"},
    "file_count_claimed": {"const": false},
    "notes": {"type": "string"},
    "batch_policy": {
      "type": "object",
      "required": ["preferred_pack_count", "candidate_auto_promotion", "human_art_direction_required", "android_device_gate_required"]
    },
    "targets": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "target", "contract_key"],
        "properties": {
          "id": {"type": "string"},
          "target": {"type": "integer", "minimum": 1},
          "contract_key": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "gold_slice_priority": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "promotion_states": {"type": "array", "minItems": 8, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
