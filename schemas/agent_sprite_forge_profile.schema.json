{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_sprite_forge_profile.schema.json",
  "title": "Cria do Tatame Agent Sprite Forge profile",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "status",
    "source",
    "dependency_policy",
    "adoption",
    "compatibility",
    "execution",
    "promotion_gates",
    "upstream_test_snapshot"
  ],
  "properties": {
    "$schema": {"const": "agent_sprite_forge_profile_v1"},
    "version": {"type": "string", "pattern": "^1\\.0\\.0$"},
    "status": {"const": "approved_candidate_postprocessor"},
    "verified_on": {"type": "string", "format": "date"},
    "source": {
      "type": "object",
      "required": ["repository", "pinned_commit", "license", "license_sha256", "requirements_sha256", "entrypoint", "entrypoint_sha256"],
      "properties": {
        "repository": {"const": "https://github.com/0x0funky/agent-sprite-forge"},
        "pinned_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"const": "MIT"},
        "license_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "requirements_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entrypoint": {"type": "string"},
        "entrypoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "dependency_policy": {
      "type": "object",
      "required": ["runtime_dependency", "runtime_network_required", "vendored_into_game", "installation", "packages", "automatic_global_skill_install"],
      "properties": {
        "runtime_dependency": {"const": false},
        "runtime_network_required": {"const": false},
        "vendored_into_game": {"const": false},
        "installation": {"const": "external_checkout_only"},
        "python": {"type": "string"},
        "packages": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "automatic_global_skill_install": {"const": false}
      },
      "additionalProperties": false
    },
    "adoption": {
      "type": "object",
      "required": ["approved", "conditional", "blocked"],
      "properties": {
        "approved": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "conditional": {"type": "array", "items": {"type": "string"}},
        "blocked": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "compatibility": {"type": "object"},
    "execution": {
      "type": "object",
      "required": ["adapter", "candidate_output_root", "required_processor_flags", "candidate_state", "promotion_allowed", "raw_source_rights_required"],
      "properties": {
        "adapter": {"type": "string"},
        "candidate_output_root": {"type": "string"},
        "required_processor_flags": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "candidate_state": {"const": "candidate"},
        "promotion_allowed": {"const": false},
        "raw_source_rights_required": {"const": true}
      },
      "additionalProperties": false
    },
    "promotion_gates": {"type": "array", "minItems": 8, "items": {"type": "string"}},
    "upstream_test_snapshot": {
      "type": "object",
      "required": ["command", "tests_run", "result"],
      "properties": {
        "command": {"type": "string"},
        "tests_run": {"type": "integer", "minimum": 1},
        "result": {"const": "pass"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
