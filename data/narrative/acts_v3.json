    "stages": [
      {
        "id": "Z1",
        "title": "A Feira",
        "text": "Ituberá. Ruan e Joaquim, cerca de 12 anos. Duas moedas por corrida. O carro pesa; o amigo pequeno conta com você.",
        "mode": "delivery",
        "objective": "Leve três compras ao cais. Desvie das bancas e respire para recuperar o gás.",
        "reward_brl_per_delivery": 2
      },
      {
        "id": "Z2",
        "title": "A Cobrança",
        "text": "Os cobradores cercam os dois e exigem o dinheiro. Ruan adianta o ombro para proteger Joaquim.",
        "mode": "choice",
        "choices": [
          {
            "id": "brigar",
            "label": "Armar o ombro para brigar",
            "consequence": "Joaquim recua assustado. A ameaça cresce; Dendê intervém antes do soco."
          },
          {
            "id": "recuar",
            "label": "Recuar junto com Joaquim",
            "consequence": "Vocês protegem um ao outro. Os cobradores avançam; Dendê intervém."
          }
        ]
      },
      {
        "id": "Z3",
        "title": "O Pulso",
        "text": "Uma mão velha segura o pulso de Ruan sem apertar. Dendê desloca o cobrador, que senta sem se machucar. “Menino, tu é grande p/ brigar e pequeno p/ se esconder. Vem cá que eu te ensino um terceiro jeito.”",
        "mode": "dialogue"
      },
      {
        "id": "Z4",
        "title": "O Terreiro",
        "text": "Os dois ajudam a varrer e consertar o tatame. Dendê e Degodo acompanham a primeira roda. Aqui, proteger também é saber soltar.",
        "mode": "training",
        "steps": [
          "Varrer o Terreiro",
          "Consertar o tatame",
          "Estabelecer a pegada",
          "Conquistar posição",
          "Respeitar o tap de Joaquim"
        ]
      },
      {
        "id": "Z5",
        "title": "O Tabuleiro",
        "text": "Joaquim abre o tabuleiro de papelão e ajeita as tampinhas. “O tatame é um tabuleiro que anda.” A força de Ruan e a leitura de Joaquim começam a trabalhar juntas.",
        "mode": "reading",
        "question": "Joaquim fechou o caminho. Qual é o próximo lance?",
        "choices": [
          {
            "id": "forcar",
            "label": "Gastar todo o gás insistindo",
            "correct": false
          },
          {
            "id": "ler",
            "label": "Respirar e procurar outro ângulo",
            "correct": true
          }
        ]
      }
