{
  "$schema": "combat_presentation_v1",
  "version": "1.0.0",
  "runtime_policy": {
    "simulation_independent": true,
    "offline_required": true,
    "presentation_may_not_change_outcome": true,
    "safe_submission_language": true
  },
  "android_budgets": {
    "max_concurrent_impacts": 5,
    "max_concurrent_sfx": 8,
    "max_hit_stop_ms": 100,
    "max_shake_px": 8.0,
    "max_shake_ms": 140,
    "max_flash_alpha": 0.16,
    "max_haptic_ms": 45,
    "max_strobe_hz": 2.0
  },
  "accessibility": {
    "default": {"motion_scale": 1.0, "shake_scale": 1.0, "flash_scale": 1.0, "haptics": true},
    "reduced_motion": {"motion_scale": 0.25, "shake_scale": 0.0, "flash_scale": 0.0, "haptics": true}
  },
  "defaults": {
    "success": {
      "hit_stop_ms": 28,
