{
  "$schema": "cria.grappling_reaction_policy.v1",
  "version": "1.0.0",
  "status": "ACTIVE_VISUAL_REACTION_POLICY",
  "authority": "NON_AUTHORITATIVE_VISUAL_AND_AI_HINTS",
  "purpose": "Rank plausible defensive/reaction intents from explicit combat context for animation selection and AI hinting without executing techniques or changing reducer truth.",
  "score_model": {
    "base_score": 1.0,
    "exact_attack_type_bonus": 2.0,
    "position_match_bonus": 1.5,
    "mode_match_bonus": 0.5,
    "role_match_bonus": 0.75,
    "grip_signature_bonus": 0.75,
    "low_gas_penalty": 0.5,
    "tie_break": "reaction_id_ascending"
  },
  "gas_buckets": {
    "fresh": [67.0, 100.0],
    "working": [34.0, 66.999],
    "fatigued": [0.0, 33.999]
  },
