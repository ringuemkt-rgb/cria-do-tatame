  "granularity_policy": {
    "runtime_collapses": ["open_guard", "closed_guard", "half_guard", "north_south", "knee_on_belly", "hundred_kilos"],
    "reason": "A vertical slice preserva uma FSM pequena; variacoes vivem em tags, cartas e animacao ate haver evidencia de playtest para novos estados."
  },
