    {"id": "PLAYER_BACK_ATTACK", "semantic_position": "back_attack", "context": "ground"},
    {"id": "PLAYER_BACK_DEFENSE", "semantic_position": "back_defense", "context": "ground"},
    {"id": "PLAYER_SUBMISSION_ATTACK", "semantic_position": "submission_attack", "context": "submission"},
    {"id": "PLAYER_SUBMISSION_DEFENSE", "semantic_position": "submission_defense", "context": "submission"},
    {"id": "RESET", "semantic_position": "respect_reset", "context": "reset"}
