{
  "schema_version": "1.0.0",
  "repository": "ringuemkt-rgb/cria-do-tatame",
  "default_branch": "main",
  "single_source_of_truth": true,
  "runtime": "Godot",
  "required_root_files": [
    "README.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "project.godot",
    "export_presets.cfg",
    "package.json",
    ".editorconfig",
    ".gitattributes",
    ".gitignore"
  ],
  "required_governance_files": [
    ".github/CODEOWNERS",
    ".github/pull_request_template.md",
    ".github/ISSUE_TEMPLATE/bug_report.yml",
    ".github/ISSUE_TEMPLATE/work_item.yml",
    ".github/ISSUE_TEMPLATE/config.yml",
    "docs/INDEX.md",
    "docs/REPOSITORY_GOVERNANCE.md",
    "docs/ROADMAP.md"
  ],
  "canonical_directories": [
    ".github",
    ".agents",
    "assets",
    "data",
    "docs",
    "scenes",
    "src",
    "tests",
    "tools"
  ],
  "allowed_branch_prefixes": [
    "fix/",
    "feat/",
    "content/",
    "visual/",
    "build/",
    "docs/",
    "chore/",
    "release/"
  ],
  "forbidden_parallel_runtime_paths": [
    "game/project.godot",
    "app/project.godot",
    "godot/project.godot",
    "frontend/package.json"
  ],
  "protected_invariants": {
    "main_scene": "res://scenes/main_menu/MainMenu.tscn",
    "protagonist_id": "ruan_macacao",
    "active_factions": ["LEM", "NTM", "ALE"],
    "critical_gameplay_offline": true,
    "second_runtime_forbidden": true,
    "secrets_in_repository_forbidden": true
  },
  "required_pull_request_evidence": [
    "objective",
    "scope",
    "integration_consumer",
    "tests",
    "risks",
    "rollback"
  ],
  "completion_states": [
    "specified",
    "implemented",
    "integrated",
    "automated_validation_passed",
    "human_or_device_tested",
    "release_ready"
  ]
}
