    "save_after_restart_required": true,
    "no_fatal_logcat_required": true,
    "thermal_severe_allowed": false,
    "metrics_required": [
      "device",
      "android",
      "abi",
      "display",
      "memory",
      "gfxinfo",
      "battery",
      "thermal",
      "logcat"
    ],
    "release_ready_default": false
