    "world": "WorldDirectorManager",
    "map": "WorldMapManager",
    "audio": "AudioManager",
    "save": "SaveManager"
  },
  "fight_acceptance": {
    "required_techniques": [
      "t001",
      "slice_sprawl",
      "t005",
      "t025",
      "t049",
      "slice_side_to_mount",
      "t057"
    ],
    "touch_counter_floor_ms": 250,
    "cards_visible_max": 6,
    "input_paths": [
      "touch",
      "mouse",
      "keyboard_1_to_6"
