    "combat_hud": {
      "purpose": "runtime",
      "playfield_protection_required": true,
      "persistent_primary_clusters_max": 1,
      "persistent_secondary_clusters_max": 1,
      "touch_target_dp_min": 48,
      "safe_area_percent_min": 7,
      "dense_lore_panels_forbidden_during_combat": true
    },
    "art_bible_hud": {
      "purpose": "explanation_and_pitch",
      "runtime_direct_use": false,
      "dense_information_allowed": true
    }
  },
  "gi_no_gi": {
    "simple_costume_swap_forbidden": true,
    "ruleset_compatibility_required": true,
    "gi": {
      "cloth_grips_allowed_only_by_technique": true,
