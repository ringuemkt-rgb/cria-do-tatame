{
  "schema_version": 1,
  "project": "cria_do_tatame_pressao",
  "engine": "Godot 4.3+",
  "platforms": ["android_arm64", "windows_x86_64", "web"],
  "canon": {
    "protagonist": "ruan_macacao",
    "region": "Baixo Sul da Bahia",
