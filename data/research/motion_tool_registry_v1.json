      "adoption": "OPTIONAL_OFFLINE_RESEARCH"
    },
    {
      "id": "brax",
      "source": "google/brax",
      "observed_license": "Apache-2.0",
      "roles": ["accelerated_offline_control", "self_play_research"],
      "adoption": "OPTIONAL_OFFLINE_RESEARCH"
    },
    {
      "id": "genesis",
      "source": "Genesis-Embodied-AI/Genesis",
      "observed_license": "Apache-2.0 source observed",
      "roles": ["embodied_physics_research", "synthetic_control_experiments"],
      "adoption": "OPTIONAL_OFFLINE_RESEARCH"
    }
  ],
  "external_executable_only": [
    {
      "id": "ffmpeg",
      "source": "FFmpeg",
