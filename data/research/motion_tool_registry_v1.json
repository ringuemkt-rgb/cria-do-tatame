{
  "$schema": "cria.motion_tool_registry.v1",
  "version": "1.0.0",
  "status": "RESEARCH_AND_AUTHORING_REGISTRY_NOT_REUSE_AUTHORITY",
  "audited_at": "2026-09-12",
  "shipping": false,
  "reuse_authority": "data/production/external_tool_registry_v1.json",
  "policy": {
    "this_registry_may_authorize_runtime_dependency": false,
    "this_registry_may_authorize_asset_shipping": false,
    "code_license_does_not_grant_checkpoint_rights": true,
    "checkpoint_license_does_not_grant_dataset_rights": true,
    "dataset_license_does_not_grant_unrelated_media_rights": true,
    "external_tool_output_requires_cria_provenance_and_review": true,
    "pin_exact_revision_before_production_adoption": true
  },
  "high_value_candidates": [
    {
      "id": "pose2sim",
      "source": "perfanalytics/pose2sim",
      "observed_license": "BSD-3-Clause",
      "roles": ["multiview_calibration", "camera_sync", "multi_person_3d_kinematics", "opensim_export", "reprojection_qa"],
      "adoption": "PREFERRED_OWN_CAPTURE_CANDIDATE",
      "notes": "Current package metadata declares BSD-3-Clause. Audit bundled/optional pose models separately."
    },
    {
      "id": "opensim",
      "source": "opensim-org/opensim-core",
      "observed_license": "Apache-2.0",
      "roles": ["musculoskeletal_analysis", "kinematic_qa", "optional_motion_hypothesis_testing"],
      "adoption": "OPTIONAL_BIOMECHANICS_CANDIDATE",
      "notes": "Core is permissive; third-party components remain independently reviewable. Never use simulation as rules or technique authority."
    },
    {
      "id": "sam2",
      "source": "facebookresearch/sam2",
      "observed_license": "Apache-2.0 with ancillary exceptions",
      "roles": ["athlete_segmentation", "mask_tracking", "occlusion_support"],
      "adoption": "HIGH_VALUE_PRELABEL_CANDIDATE",
      "notes": "Model/code/checkpoint terms must be pinned at adoption time; masks are candidates, not facts."
    },
    {
      "id": "mmpose_rtmpose",
      "source": "open-mmlab/mmpose",
      "observed_license": "Apache-2.0 code",
      "roles": ["2d_pose", "whole_body_pose", "hand_and_body_keypoint_candidates"],
      "adoption": "PREFERRED_POSE_CANDIDATE",
      "notes": "Specific checkpoints and training datasets require separate rights review."
    },
    {
      "id": "mixamo_llm_mocap",
      "source": "squall01337/mixamo-llm-mocap",
      "revision": "00dfd5385506022d533c84f6737a09f5f4392623",
      "observed_license": "MIT repository code; Mixamo, GVHMR, pretrained checkpoints, SMPL-X and Blender MCP terms are separate",
      "roles": [
        "locked_camera_pose_to_mixamo_retarget",
        "two_performer_pair_retarget",
        "root_motion_reference",
        "foot_planting_qa",
        "frame_reference_comparison",
        "pair_spacing_reach_intrusion_qa",
        "evaluated_mesh_contact_qa",
        "preview_render"
      ],
      "adoption": "ADOPTED_PINNED_OFFLINE_AUTHORING_ADAPTER_LICENSE_GATED",
      "runtime_dependency": false,
      "commercial_output_default": "BLOCKED_UNTIL_THIRD_PARTY_LICENSE_GATE",
      "notes": "High-value bridge from rights-cleared locked-camera plates to measured Mixamo-style retarget references. CRIA calls a separate pinned checkout through tools/motion_factory/run_mixamo_llm_mocap.py. It is not BJJ authority, not a Godot dependency and does not auto-promote generated output."
    },
    {
      "id": "mmaction2",
      "source": "open-mmlab/mmaction2",
      "observed_license": "Apache-2.0 code",
      "roles": ["temporal_action_candidate", "temporal_localization", "pose_action_benchmark"],
      "adoption": "PRELABEL_ONLY_CANDIDATE",
      "notes": "Action predictions cannot define CRIA technique truth."
    },
    {
      "id": "cvat_community",
      "source": "cvat-ai/cvat",
      "observed_license": "MIT for CVAT Community; FFmpeg and optional/serverless components may have separate terms",
      "roles": ["video_annotation", "track_review", "quality_control", "team_annotation"],
      "adoption": "PREFERRED_ANNOTATION_UI_CANDIDATE"
    },
    {
      "id": "label_studio",
      "source": "HumanSignal/label-studio",
      "observed_license": "Apache-2.0 community project",
      "roles": ["multimodal_annotation", "annotation_workflow_alternative"],
      "adoption": "ANNOTATION_ALTERNATIVE"
    },
    {
      "id": "dvc",
      "source": "treeverse/dvc",
      "observed_license": "Apache-2.0",
      "roles": ["dataset_versioning", "pipeline_reproducibility", "experiment_lineage"],
      "adoption": "PREFERRED_DATA_VERSIONING_CANDIDATE"
    },
    {
      "id": "fiftyone",
      "source": "voxel51/fiftyone",
      "observed_license": "Apache-2.0 project metadata observed",
      "roles": ["dataset_visual_qa", "error_analysis", "embedding_and_label_inspection"],
      "adoption": "DATASET_QA_CANDIDATE"
    },
    {
      "id": "mujoco",
      "source": "google-deepmind/mujoco",
