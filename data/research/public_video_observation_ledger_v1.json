{
  "$schema": "cria.public_video_observation_ledger.v1",
  "version": "1.0.0",
  "status": "ACTIVE_EMPTY_LEDGER",
  "shipping": false,
  "director": "data/research/public_video_analysis_director_v1.json",
  "policy": {
    "empty_is_valid": true,
    "raw_media_storage": false,
    "third_party_frame_storage": false,
    "timestamped_transformed_notes_allowed": true,
    "metadata_only_must_be_labeled": true,
    "transcript_only_must_be_labeled": true,
    "visual_claim_requires_visual_access": true,
    "rights_sensitive_derivation_requires_separate_gate": true
  },
  "required_source_fields": [
    "source_id",
    "platform",
    "source_locator",
    "title",
    "publisher_or_channel",
    "published_at",
    "accessed_at",
    "source_class",
    "access_mode",
    "capability_state",
    "rights_status",
    "allowed_operations",
    "forbidden_operations",
    "metadata_provenance",
    "notes"
  ],
  "required_observation_fields": [
    "observation_id",
    "source_id",
    "start_ms",
    "end_ms",
    "observation_type",
    "evidence_mode",
    "status",
    "summary",
    "position_candidate",
    "technique_candidate",
    "phase_candidate",
    "success_failure_counter",
    "rules_candidate",
    "occlusion_state",
    "confidence",
    "authority_crosscheck",
    "contradiction_flags",
    "project_impact",
    "review_status"
  ],
  "sources": [],
  "observations": [],
  "claims": {
    "sources_discovered": 0,
    "sources_visually_reviewed": 0,
    "timestamped_observations": 0,
    "triangulated_findings": 0,
    "motion_derivation_eligible_sources": 0
  }
}
