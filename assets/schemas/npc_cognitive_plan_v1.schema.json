{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cria.npc_cognitive_plan.v1.schema",
  "title": "CRIA NPC Cognitive Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "npc_id", "goal_id", "strategy_tags", "candidate_actions", "valid_until_tick"],
  "properties": {
    "version": {"const": "1.0.0"},
    "npc_id": {"type": "string", "minLength": 1},
    "goal_id": {"type": "string", "minLength": 1},
    "strategy_tags": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidate_actions": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["action_id", "category", "weight"],
        "properties": {
          "action_id": {"type": "string", "minLength": 1},
          "category": {"enum": ["WORLD", "SOCIAL", "TRAINING", "BJJ", "COMPETITION", "DAMAGE_FATIGUE", "CINEMATIC"]},
          "weight": {"type": "number", "minimum": 0, "maximum": 1},
          "target_actor_id": {"type": ["string", "null"]}
        }
      }
    },
    "valid_until_tick": {"type": "integer", "minimum": 0},
    "memory_summary_candidate": {"type": ["string", "null"], "maxLength": 600}
  }
}
