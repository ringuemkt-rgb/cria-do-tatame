{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cria.world_art_package.v2.schema",
  "title": "CRIA World Art Package V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location_id",
    "world_source_refs",
    "regional_reference_status",
    "layers",
    "collision_metadata",
    "navigation_metadata",
    "runtime_evidence",
    "human_visual_review",
    "rights_status",
    "shipping"
  ],
  "properties": {
    "location_id": {"type": "string", "minLength": 1},
    "world_source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "regional_reference_status": {"type": "string", "enum": ["PENDING", "REVIEWED", "REJECTED"]},
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terrain_or_base", "structures", "props", "foreground_occlusion", "lighting_profile", "weather_profile", "ambient_fx_profile"],
      "properties": {
        "terrain_or_base": {"type": ["string", "null"]},
        "structures": {"type": ["string", "null"]},
        "props": {"type": ["string", "null"]},
        "foreground_occlusion": {"type": ["string", "null"]},
        "lighting_profile": {"type": ["string", "null"]},
        "weather_profile": {"type": ["string", "null"]},
        "ambient_fx_profile": {"type": ["string", "null"]}
      }
    },
    "collision_metadata": {"type": ["string", "null"]},
    "navigation_metadata": {"type": ["string", "null"]},
    "runtime_evidence": {"type": "array", "items": {"type": "string"}},
    "human_visual_review": {"type": "string", "enum": ["PENDING", "PASS", "FAIL"]},
    "rights_status": {"type": "string", "enum": ["PENDING", "CLEARED", "BLOCKED", "UNKNOWN"]},
    "shipping": {"const": false}
  }
}
