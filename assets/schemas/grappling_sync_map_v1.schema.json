{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cria.grappling_sync_map.v1.schema",
  "title": "CRIA Grappling Paired Sync Map V1",
  "description": "Deterministic time-domain synchronization between attacker and defender sprite streams for a reviewed paired grappling clip.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "duration_ms", "attacker_frames", "defender_frames", "phases", "sync_points", "shared_pivot", "human_approval"],
  "properties": {
    "version": {"const": "1.0.0"},
    "duration_ms": {"type": "integer", "minimum": 1},
    "attacker_frames": {"type": "integer", "minimum": 1},
    "defender_frames": {"type": "integer", "minimum": 1},
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "start_ms", "end_ms"],
        "properties": {
          "phase": {"enum": ["anticipation", "entry", "establish", "stabilize", "response", "recovery"]},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1}
        }
      }
    },
    "sync_points": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time_ms", "attacker_frame", "defender_frame", "contact_signature"],
        "properties": {
          "time_ms": {"type": "integer", "minimum": 0},
          "attacker_frame": {"type": "integer", "minimum": 0},
          "defender_frame": {"type": "integer", "minimum": 0},
          "contact_signature": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "shared_pivot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "policy"],
      "properties": {
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "policy": {"const": "PAIR_WORLD_ANCHOR"}
      }
    },
    "human_approval": {"const": true}
  }
}
