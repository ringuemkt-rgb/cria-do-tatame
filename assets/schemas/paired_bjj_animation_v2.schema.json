{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cria.paired_bjj_animation.v2.schema",
  "title": "CRIA Paired BJJ Animation V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "technique_id",
    "from_position",
    "to_position",
    "attacker_role",
    "defender_role",
    "modality",
    "pivot_policy",
    "phases",
    "sync_points",
    "contact_points",
    "attacker_frames",
    "defender_frames",
    "biomechanical_review",
    "human_approval",
    "shipping"
  ],
  "properties": {
    "technique_id": {"type": "string", "minLength": 1},
    "from_position": {"type": "string", "minLength": 1},
    "to_position": {"type": "string", "minLength": 1},
    "attacker_role": {"type": "string", "minLength": 1},
    "defender_role": {"type": "string", "minLength": 1},
    "modality": {"type": "string", "enum": ["gi", "nogi", "both"]},
    "pivot_policy": {"type": "string", "enum": ["shared", "shared_dynamic", "per_phase_shared"]},
    "phases": {
      "type": "array",
      "prefixItems": [
        {"const": "anticipation"},
        {"const": "entry"},
        {"const": "establish"},
        {"const": "stabilize"},
        {"const": "response"},
        {"const": "recovery"}
      ],
      "minItems": 6,
      "maxItems": 6
    },
    "sync_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "attacker_frame", "defender_frame"],
        "properties": {
          "phase": {"type": "string"},
          "attacker_frame": {"type": "integer", "minimum": 0},
          "defender_frame": {"type": "integer", "minimum": 0}
        }
      }
    },
    "contact_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "attacker_limb", "defender_target", "contact_type"],
        "properties": {
          "phase": {"type": "string"},
          "attacker_limb": {"type": "string"},
          "defender_target": {"type": "string"},
          "contact_type": {"type": "string"}
        }
      }
    },
    "attacker_frames": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "defender_frames": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "biomechanical_review": {"type": "string", "enum": ["PENDING", "PASS", "FAIL"]},
    "human_approval": {"type": "boolean"},
    "shipping": {"const": false},
    "notes": {"type": "string"}
  }
}
