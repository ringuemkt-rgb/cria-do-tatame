{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cria.motion_clip_contract.v1.schema",
  "title": "CRIA Motion Clip Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "clip_id", "action_id", "kind", "start_state", "end_state",
    "manifest_path", "frame_count", "pivot_policy", "events", "human_approval", "shipping"
  ],
  "properties": {
    "version": {"const": "1.0.0"},
    "clip_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["LOOP", "ONE_SHOT", "TRANSITION", "PAIRED_BJJ"]},
    "character_id": {"type": ["string", "null"]},
    "paired_character_id": {"type": ["string", "null"]},
    "start_state": {"type": "string", "minLength": 1},
    "end_state": {"type": "string", "minLength": 1},
    "manifest_path": {"type": "string", "minLength": 1},
    "paired_contract_path": {"type": ["string", "null"]},
    "frame_count": {"type": "integer", "minimum": 1},
    "pivot_policy": {"enum": ["CANONICAL_UPRIGHT", "SHARED", "SHARED_DYNAMIC", "PER_PHASE_SHARED"]},
    "events": {"type": "array", "items": {"type": "object"}},
    "biomechanical_review": {"enum": ["NOT_APPLICABLE", "PENDING", "PASS", "FAIL"]},
    "human_approval": {"type": "boolean"},
    "shipping": {"const": false}
  }
}
